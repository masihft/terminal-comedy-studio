# Terminal Comedy Studio — configuration example
#
# Copy this file to .env and fill in only what you use.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key.
# Anything set in your shell wins over this file, so you can try another
# provider with a one-off export:
#
#   AI_PROVIDER=openrouter comedian
#
# Leave AI_PROVIDER empty (or set it to "offline") to run the comedian with no
# provider at all. The offline show is written in the repository and needs no
# network.

# ---------------------------------------------------------------- primary ---
# One of: offline | openai | anthropic | openrouter | omniroute | local
AI_PROVIDER=
# Model override for whichever provider you chose. Each provider also has its
# own <PROVIDER>_MODEL below, which takes precedence.
AI_MODEL=

# fa (Persian) or en. Persian is the default.
LANGUAGE=fa
# Which comedian is on stage: default | sarkash | mr-blonde
COMEDIAN_CHARACTER=default

# ------------------------------------------------------------- generation ---
COMEDIAN_TIMEOUT=30
COMEDIAN_TEMPERATURE=0.9
COMEDIAN_MAX_TOKENS=400

# ----------------------------------------------------------------- output ---
# Set to any value to turn all colour off (also honoured automatically by the
# NO_COLOR convention).
# NO_COLOR=1

# ------------------------------------------------------------ providers -----
# You only need one of these blocks. An unset API key means the provider is
# skipped, not an error.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter (model must be a full "vendor/model" route id)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# OmniRoute — a gateway you run yourself. Nothing about its address is baked
# into the application; both values below must be yours.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Any other OpenAI-compatible server: a local model, a vLLM box, a corporate
# gateway. No API key is required unless your server asks for one.
LOCAL_BASE_URL=
LOCAL_API_KEY=
LOCAL_MODEL=
